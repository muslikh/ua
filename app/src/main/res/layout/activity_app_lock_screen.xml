<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <ImageView
        android:id="@+id/ivLockedAppIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/sym_def_app_icon"/>

    <TextView
        android:id="@+id/tvLockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aplikasi Terkunci"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masukkan PIN 4 digit untuk membuka"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:textColor="?android:attr/textColorSecondary"/>

    <!-- PIN dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#CCCCCC"/>

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#CCCCCC"/>

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#CCCCCC"/>

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#CCCCCC"/>
    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins">

        <Button
            android:id="@+id/btnKey1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="1"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="2"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="3"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="4"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="5"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="6"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey7"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="7"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey8"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="8"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey9"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="9"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKeyCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="Batal"
            android:textSize="14sp"
            android:textColor="#D32F2F"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKey0"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="0"
            android:textSize="24sp"
            app:cornerRadius="40dp"/>

        <Button
            android:id="@+id/btnKeyDelete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:text="⌫"
            android:textSize="22sp"
            app:cornerRadius="40dp"/>
    </GridLayout>

</LinearLayout>
