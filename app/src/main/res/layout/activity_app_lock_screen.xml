<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLockScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/lockScreenBg">

    <!-- App Icon in glowing frame -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivLockedAppIcon"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:contentDescription="App Icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aplikasi Terkunci"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/tvLockPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masukkan PIN 4 digit untuk membuka"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:textColor="#94A3B8"/>

    <!-- PIN dots container -->
    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="36dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#334155"/>

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#334155"/>

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#334155"/>

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#334155"/>
    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins">

        <Button
            android:id="@+id/btnKey1"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="1"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey2"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="2"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey3"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="3"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey4"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="4"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey5"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="5"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey6"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="6"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey7"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="7"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey8"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="8"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey9"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="9"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKeyCancel"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="Batal"
            android:textSize="14sp"
            android:textColor="#EF4444"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKey0"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="0"
            android:textSize="24sp"
            android:textColor="@color/lockKeyText"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnKeyDelete"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_margin="8dp"
            android:text="⌫"
            android:textSize="22sp"
            android:textColor="#94A3B8"
            android:background="@drawable/bg_pin_keypad"
            style="?android:attr/borderlessButtonStyle"/>
    </GridLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Dilindungi oleh MyTools Security"
        android:textSize="11sp"
        android:textColor="#475569"
        android:layout_marginTop="24dp"/>

</LinearLayout>
